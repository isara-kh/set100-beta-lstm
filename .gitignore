# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---- Virtual environments ----
.venv/
.venv-whisper/
venv/
env/

# ---- Tooling / editor / OS ----
.cache_mpl/
.DS_Store
*.log

# ---- Data & model artifacts (regenerated by the pipeline; not versioned) ----
# Raw inputs and trained models are never published (licensing / size). The one
# exception is the out-of-sample forecast table: it holds only derived statistics
# (forward realized betas, the three forecasts, log market cap), which is what
# makes the evaluation, DM and subsample steps runnable from a bare clone. Git
# cannot re-include a file under an excluded *directory*, hence the /data/* chain.
/data/*
!/data/processed/
/data/processed/*
!/data/processed/oos_forecasts.parquet
/models/

# ---- Generated figures (keep the folder, ignore its contents) ----
/figures/*
!/figures/.gitkeep

# ---- Not distributed (copyright / private / large) ----
/references/
/notes_private/
/paper_local/
/local/

# ---- Author-only notebooks (kept locally, not published: thesis-audit artifacts
#      and the generator for 02_lstm_explained) ----
/notebooks/paper_companion.ipynb
/notebooks/table2_audit.ipynb
/notebooks/build_lstm_explained_nb.py
*.m4a
*.zip
*.bak
*.verified_bak

# ---- Working notes under docs/ stay local; ADRs and the README's figures
#      are project content ----
/docs/*
!/docs/adr/
!/docs/img/
